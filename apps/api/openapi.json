{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "description": "Public check used by load balancers and local smoke tests. Returns 503 when Postgres cannot be reached.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API and Postgres are up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Postgres is down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "API and Postgres liveness",
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "description": "Issues an access token and a refresh token. The refresh token is returned in the body and set as the httpOnly `refresh_token` cookie. First login with a temporary PIN sets `mustChangePin`.",
        "operationId": "postAuthLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid phone or PIN."
          },
          "403": {
            "description": "Account is suspended."
          },
          "429": {
            "description": "Too many PIN attempts or login rate limit."
          }
        },
        "summary": "Sign in with phone and PIN",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "description": "Accepts `refreshToken` in the JSON body or the `refresh_token` httpOnly cookie. Returns a new token pair and revokes the previous refresh token.",
        "operationId": "postAuthRefresh",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access and refresh tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token missing or invalid."
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "summary": "Rotate the refresh token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Requires a Bearer access token. Revokes the presented refresh token (body or cookie) and clears the cookie.",
        "operationId": "postAuthLogout",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Refresh token revoked."
          },
          "401": {
            "description": "Access token missing or invalid."
          }
        },
        "security": [
          {
            "refresh_token": []
          },
          {
            "access-token": []
          }
        ],
        "summary": "Revoke the current refresh token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/pin": {
      "post": {
        "description": "Sets a new 4-digit PIN. `currentPin` is required unless `mustChangePin` is true (temporary PIN from invite).",
        "operationId": "postAuthPin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePinDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "PIN updated."
          },
          "401": {
            "description": "Access token or current PIN invalid."
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Replace PIN",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Returns the signed-in household user (memberships and enabled modules) or IoTeedom staff profile, discriminated by `kind`.",
        "operationId": "getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current household user or staff profile.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/MeUserResponseDto"
                    },
                    {
                      "$ref": "#/components/schemas/MeStaffResponseDto"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "user": "#/components/schemas/MeUserResponseDto",
                      "staff": "#/components/schemas/MeStaffResponseDto"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Access token missing or invalid."
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Current user or staff session",
        "tags": [
          "Me"
        ]
      }
    },
    "/v1/onboarding/complete": {
      "post": {
        "description": "Owner-only. Confirms the invited property for the account and marks onboarding complete so the household dashboard is available.",
        "operationId": "postOnboardingComplete",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteOnboardingDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account marked active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingCompleteResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Access token missing or invalid."
          },
          "403": {
            "description": "Staff caller, or the account is suspended."
          },
          "404": {
            "description": "No owner membership for this account."
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Confirm the invited property and mark the account active",
        "tags": [
          "Onboarding"
        ]
      }
    },
    "/v1/ops/invites": {
      "post": {
        "operationId": "postOpsInvites",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteOwnerDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsInviteResponseDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": "Caller is not staff"
          },
          "409": {
            "description": "Phone already on the platform"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Invite a property owner",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/ops/accounts": {
      "get": {
        "operationId": "getOpsAccounts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsAccountListResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "List owner accounts",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/ops/accounts/{id}": {
      "get": {
        "operationId": "getOpsAccountsById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsAccountListItemDto"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Owner account for support",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/ops/audit": {
      "get": {
        "operationId": "getOpsAudit",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsAuditListResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Recent staff audit events",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/payments": {
      "post": {
        "description": "Creates a payment through Paystack (test keys or recorded fixtures). Collection success is a later webhook, not this response. Dashboard fields are `ourRef`, `status`, and `displayText`.",
        "operationId": "postPayments",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentViewResponseDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          },
          "404": {
            "description": ""
          },
          "409": {
            "description": "Idempotency-Key reused with a different body"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a MoMo charge",
        "tags": [
          "Payments"
        ]
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "description": "Returns receipt-safe fields only. Provider secrets and raw Paystack payloads stay on the server.",
        "operationId": "getPaymentsById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentViewResponseDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Payment status for the payer",
        "tags": [
          "Payments"
        ]
      }
    },
    "/v1/payments/{id}/retry": {
      "post": {
        "description": "Creates a new payment with a new `ourRef`, linked via `retryOfId`.",
        "operationId": "postPaymentsRetry",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryPaymentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentViewResponseDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Retry a failed payment",
        "tags": [
          "Payments"
        ]
      }
    }
  },
  "info": {
    "title": "IoTeedom Smart Pay API",
    "description": "Auth, session, ops invites, payments, onboarding, and health for Smart Pay.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Phone and PIN sign-in, token refresh, logout, and PIN change."
    },
    {
      "name": "Me",
      "description": "The signed-in household user or IoTeedom staff member."
    },
    {
      "name": "Onboarding",
      "description": "First-login property confirmation for invited owners."
    },
    {
      "name": "ops",
      "description": "Staff invite, account list, and audit. Suspend and module edits are later."
    },
    {
      "name": "Payments",
      "description": "MoMo charges through Paystack. Collection success is a webhook, not this POST."
    },
    {
      "name": "Health",
      "description": "Liveness of the API process and Postgres."
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "enum": [
              "api",
              "worker"
            ],
            "type": "string"
          },
          "postgres": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "redis": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "024 412 8891",
            "description": "Ghana phone number."
          },
          "pin": {
            "type": "string",
            "example": "2468",
            "minLength": 4,
            "maxLength": 4,
            "pattern": "^\\d{4}$",
            "description": "4-digit PIN."
          }
        },
        "required": [
          "phone",
          "pin"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token. Send as `Authorization: Bearer <token>`."
          },
          "refreshToken": {
            "type": "string",
            "description": "Refresh token. Also set as the httpOnly `refresh_token` cookie on `/v1/auth`."
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds.",
            "example": 900
          },
          "mustChangePin": {
            "type": "boolean",
            "description": "True when the user must replace their temporary PIN."
          },
          "principal": {
            "enum": [
              "user",
              "staff"
            ],
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "mustChangePin",
          "principal"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token. Omit when the `refresh_token` cookie is present."
          }
        }
      },
      "ChangePinDto": {
        "type": "object",
        "properties": {
          "currentPin": {
            "type": "string",
            "minLength": 4,
            "maxLength": 4,
            "pattern": "^\\d{4}$",
            "description": "Required unless `mustChangePin` is true (first login with a temp PIN)."
          },
          "newPin": {
            "type": "string",
            "example": "2468",
            "minLength": 4,
            "maxLength": 4,
            "pattern": "^\\d{4}$",
            "description": "4-digit PIN."
          }
        },
        "required": [
          "newPin"
        ]
      },
      "MePropertyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "home",
              "estate"
            ],
            "type": "string"
          },
          "ecgAccountNumber": {
            "type": "string",
            "nullable": true
          },
          "gwclAccountNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "label",
          "address",
          "city",
          "kind"
        ]
      },
      "MeMembershipDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "owner",
              "manager"
            ],
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "accountName": {
            "type": "string"
          },
          "accountKind": {
            "enum": [
              "home",
              "estate"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "invited",
              "active",
              "suspended"
            ],
            "type": "string"
          },
          "onboardedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "modules": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "example": {
              "ecg": true,
              "water": true,
              "utilities": false,
              "meters": false,
              "smart_home": false,
              "solar": false,
              "ev": false
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MePropertyDto"
            }
          }
        },
        "required": [
          "role",
          "accountId",
          "accountName",
          "accountKind",
          "status",
          "modules",
          "properties"
        ]
      },
      "MeUserResponseDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "user"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "example": "233244128891"
          },
          "phoneDisplay": {
            "type": "string",
            "example": "024 412 8891"
          },
          "mustChangePin": {
            "type": "boolean"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeMembershipDto"
            }
          }
        },
        "required": [
          "kind",
          "id",
          "name",
          "phone",
          "phoneDisplay",
          "mustChangePin",
          "memberships"
        ]
      },
      "MeStaffResponseDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "staff"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "example": "233200000001"
          },
          "phoneDisplay": {
            "type": "string",
            "example": "020 000 0001"
          },
          "role": {
            "enum": [
              "superadmin",
              "support"
            ],
            "type": "string"
          },
          "mustChangePin": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "id",
          "name",
          "phone",
          "phoneDisplay",
          "role",
          "mustChangePin"
        ]
      },
      "CompleteOnboardingDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Owner account to finish inviting."
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "example": "12 Boundary Rd, East Legon"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "example": "Accra"
          },
          "ecgAccountNumber": {
            "type": "string",
            "example": "0412345678",
            "description": "ECG customer or meter number."
          },
          "gwclAccountNumber": {
            "type": "string",
            "example": "2001234567",
            "description": "Ghana Water customer number."
          }
        },
        "required": [
          "accountId",
          "address",
          "city"
        ]
      },
      "OnboardingCompleteResponseDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "onboardedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accountId",
          "status",
          "onboardedAt"
        ]
      },
      "InviteOwnerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Kwame Boateng"
          },
          "phone": {
            "type": "string",
            "example": "024 555 0100"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "kwame@email.com"
          },
          "property": {
            "type": "string",
            "minLength": 1,
            "example": "12 Boundary Rd, East Legon"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "example": "Accra"
          },
          "kind": {
            "enum": [
              "home",
              "estate"
            ],
            "type": "string"
          },
          "modules": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "example": {
              "ecg": true,
              "water": true,
              "utilities": false,
              "meters": false,
              "smart_home": false,
              "solar": false,
              "ev": false
            }
          }
        },
        "required": [
          "name",
          "phone",
          "email",
          "property",
          "city",
          "kind",
          "modules"
        ]
      },
      "OpsInviteResponseDto": {
