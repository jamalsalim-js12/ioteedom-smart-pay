# Copy to .env at the repo root. Never commit secrets.
# Postgres is published on 5434 so it does not collide with a local 5432.

NODE_ENV=development

DATABASE_URL=postgresql://ioteedom:ioteedom@localhost:5434/ioteedom
REDIS_URL=redis://localhost:6379

API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=ioteedom-dev-jwt-access-secret-change-me

# Local seed PINs (Argon2id in Postgres, never stored in the dashboard):
# owner 024 412 8891 → 2468
# staff 020 000 0001 → 1357
